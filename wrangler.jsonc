{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberleek",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/rpc"]
  }
  // Secret (set in the Cloudflare dashboard, not here):
  //   SOLANA_RPC_URL = your Helius / QuickNode / Alchemy mainnet URL with API key
}
